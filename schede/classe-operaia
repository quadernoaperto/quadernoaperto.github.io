      <footer class="site-footer">
        <span>Quaderno Aperto · Sezione Filmoteca (quadernoaperto.github.io)</span>
        <span>La classe operaia va in paradiso (Elio Petri, 1971)</span>
      </footer>
    </main>

    <script>
      (function () {
        var bar = document.getElementById('progressBar');
        var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a'));
        var sections = links.map(function (a) { return document.querySelector(a.getAttribute('href')); }).filter(Boolean);

        function onScroll() {
          var top = window.scrollY;
          var h = document.documentElement.scrollHeight - window.innerHeight;
          if (bar && h > 0) bar.style.width = Math.min(100, Math.max(0, (top / h) * 100)) + '%';

          var currentId = '';
          sections.forEach(function (sec) {
            if (sec.getBoundingClientRect().top <= 140) currentId = sec.id;
          });
          links.forEach(function (a) {
            a.classList.toggle('active', a.getAttribute('href') === '#' + currentId);
          });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        var filterBtns = document.querySelectorAll('.scene-filter button');
        var sceneCards = document.querySelectorAll('.scene-card');
        filterBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var target = btn.getAttribute('data-filter');
            filterBtns.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            sceneCards.forEach(function (card) {
              var show = target === 'all' || card.getAttribute('data-scene') === target;
              card.classList.toggle('hidden', !show);
            });
          });
        });

        var storageKey = 'quadernoaperto_petri_1971_notes';
        try {
          var saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
          document.querySelectorAll('.note-area').forEach(function (ta) {
            var id = ta.getAttribute('data-note-id');
            if (!ta.value && saved[id]) ta.value = saved[id];
            ta.addEventListener('input', function () {
              saved[id] = ta.value;
              localStorage.setItem(storageKey, JSON.stringify(saved));
            });
          });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
